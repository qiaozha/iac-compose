{
  "name": "iac-composer",
  "version": "0.1.0",
  "description": "Define Azure infrastructure in TypeScript with provisioning libraries and compose provisioning and application deployment in authored order.",
  "type": "module",
  "bin": {
    "iac-composer": "dist/cli.js",
    "iac-composer-mcp": "dist/mcp/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".github/skills/iac-composer",
    "agent-setup"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "iac-composer": "tsx src/cli.ts",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "tsx": "^4.21.0",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "ajv": "8.17.1",
    "@types/node": "^24.0.0",
    "smol-toml": "1.9.1",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20.6"
  },
  "license": "MIT"
}
