{
  "name": "azure-infrastructure",
  "version": "0.1.0",
  "description": "Recognize Azure infrastructure intent and generate ordered IaC deployment source.",
  "type": "module",
  "bin": {
    "azure-infrastructure": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/runtime/services",
    "vendor",
    ".github/skills",
    "docs"
  ],
  "scripts": {
    "architecture:sync": "tsx src/cli.ts architecture-catalog --output .github/skills/azure-infrastructure-intent/references/architecture-catalog.json",
    "build": "tsc -p tsconfig.json",
    "azure-infrastructure": "tsx src/cli.ts",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "iac-composer": "file:../..",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20.6"
  },
  "license": "MIT"
}
