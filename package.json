{
  "name": "iac-composer",
  "version": "0.1.0",
  "description": "Compose TypeScript or JavaScript infrastructure and application deployment through azd in authored order.",
  "type": "module",
  "bin": {
    "iac-composer": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "iac-composer": "tsx src/cli.ts",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "tsx": "^4.21.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20.6"
  },
  "license": "MIT"
}
