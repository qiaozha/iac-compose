{
  "name": "imperative-deploy",
  "version": "0.1.0",
  "description": "Run JavaScript-defined Azure provisioning and application lifecycles in imperative order.",
  "type": "module",
  "bin": {
    "deploy-js": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "deploy-js": "tsx src/cli.ts",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20.6"
  },
  "license": "MIT"
}
